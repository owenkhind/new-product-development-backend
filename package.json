{
  "name": "new-product-development-backend",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS backend for the stage-gate new product development system.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "nest build",
    "seed:uat-users": "psql \"$DATABASE_URL\" -f src/database/seeds/20260505_0001_seed_uat_users.sql",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "lint": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write .",
    "test": "find test -name '*.spec.ts' ! -name '*.e2e-spec.ts' -print0 | xargs -0 node --import tsx --test",
    "test:watch": "find test -name '*.spec.ts' ! -name '*.e2e-spec.ts' -print0 | xargs -0 node --import tsx --test --watch",
    "test:cov": "npm test",
    "test:e2e": "find test -name '*.e2e-spec.ts' -print0 | xargs -0 node --import tsx --test"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/platform-express": "^11.1.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "joi": "^17.13.3",
    "pg": "^8.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^5.0.1",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.25.1",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "supertest": "^7.1.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.1"
  }
}
