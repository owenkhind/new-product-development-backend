NODE_ENV=development
PORT=3000
APP_NAME=new-product-development-backend
APP_VERSION=0.1.0
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
TEMP_AUTH_PASSWORD=Password123

# Preferred: provide a full PostgreSQL connection string.
DATABASE_URL=postgresql://postgres:password@localhost:5432/new_product_development?schema=new_product_development

# Optional fallback fields supported by the app if DATABASE_URL is not set.
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=new_product_development
DB_USERNAME=postgres
DB_PASSWORD=password
DB_SSLMODE=disable
DB_SCHEMA=new_product_development
